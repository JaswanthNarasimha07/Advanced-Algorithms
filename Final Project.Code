#include <iostream>
#include <fstream>
#include <sstream>
#include <vector>
#include <iomanip>
#include <cstdint>

// Constants used in SHA-256 algorithm
const uint32_t k[64] = {
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
};

// SHA-256 Helper Functions
uint32_t rotateRight(uint32_t x, uint32_t n) {
    return (x >> n) | (x << (32 - n));
}

uint32_t choose(uint32_t e, uint32_t f, uint32_t g) {
    return (e & f) ^ (~e & g);
}

uint32_t majority(uint32_t a, uint32_t b, uint32_t c) {
    return (a & b) ^ (a & c) ^ (b & c);
}

uint32_t sigma0(uint32_t x) {
    return rotateRight(x, 2) ^ rotateRight(x, 13) ^ rotateRight(x, 22);
}

uint32_t sigma1(uint32_t x) {
    return rotateRight(x, 6) ^ rotateRight(x, 11) ^ rotateRight(x, 25);
}

uint32_t gamma0(uint32_t x) {
    return rotateRight(x, 7) ^ rotateRight(x, 18) ^ (x >> 3);
}

uint32_t gamma1(uint32_t x) {
    return rotateRight(x, 17) ^ rotateRight(x, 19) ^ (x >> 10);
}

// Function to handle SHA-256 transformation
void sha256Transform(std::vector<uint32_t>& w, std::vector<uint32_t>& hashValues) {
    // Prepare the message schedule array (W)
    for (int i = 16; i < 64; ++i) {
        w[i] = gamma1(w[i - 2]) + w[i - 7] + gamma0(w[i - 15]) + w[i - 16];
    }

    // Initialize working variables
    uint32_t a = hashValues[0];
    uint32_t b = hashValues[1];
    uint32_t c = hashValues[2];
    uint32_t d = hashValues[3];
    uint32_t e = hashValues[4];
    uint32_t f = hashValues[5];
    uint32_t g = hashValues[6];
    uint32_t h = hashValues[7];

    // Perform the main hash computation
    for (int i = 0; i < 64; ++i) {
        uint32_t T1 = h + sigma1(e) + choose(e, f, g) + k[i] + w[i];
        uint32_t T2 = sigma0(a) + majority(a, b, c);
        h = g;
        g = f;
        f = e;
        e = d + T1;
        d = c;
        c = b;
        b = a;
        a = T1 + T2;
    }

    // Update the hash values
    hashValues[0] += a;
    hashValues[1] += b;
    hashValues[2] += c;
    hashValues[3] += d;
    hashValues[4] += e;
    hashValues[5] += f;
    hashValues[6] += g;
    hashValues[7] += h;
}

// Main function for computing SHA-256 hash
std::string sha256(const std::string& input) {
    // Initial hash values (SHA-256)
    std::vector<uint32_t> hashValues = {
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    };

    // Preprocessing (Padding)
    std::vector<uint8_t> data(input.begin(), input.end());
    uint64_t bit_len = data.size() * 8;
    data.push_back(0x80);
    while ((data.size() % 64) != 56) {
        data.push_back(0x00);
    }
    for (int i = 7; i >= 0; --i) {
        data.push_back(bit_len >> (i * 8));
    }

    // Processing each 512-bit block
    for (size_t i = 0; i < data.size(); i += 64) {
        std::vector<uint32_t> w(64);
        for (int j = 0; j < 16; ++j) {
            w[j] = (data[i + j * 4] << 24) | (data[i + j * 4 + 1] << 16) |
                   (data[i + j * 4 + 2] << 8) | (data[i + j * 4 + 3]);
        }

        // Process the block
        sha256Transform(w, hashValues);
    }

    // Produce the final hash
    std::ostringstream hash_str;
    for (auto h : hashValues) {
        hash_str << std::hex << std::setw(8) << std::setfill('0') << h;
    }

    return hash_str.str();
}

int main() {
    std::ifstream file("finalproj_256.txt");
    if (!file.is_open()) {
        std::cerr << "Error: Unable to open file.\n";
        return 1;
    }

    std::ostringstream buffer;
    buffer << file.rdbuf();
    std::string file_contents = buffer.str();

    std::string hash = sha256(file_contents);
    std::cout << "SHA-256 Hash: " << hash << std::endl;

    return 0;
}
